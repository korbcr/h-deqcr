# Variables de ambiente para producción (EJEMPLO)
# Copia y renombra este archivo según el ambiente

# API Configuration
NEXT_PUBLIC_API_URL=https://your-production-api.com
API_TOKEN=your_production_api_token_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# IMPORTANTE:
# - Nunca commits tokens reales al repositorio
# - Usa diferentes tokens para desarrollo y producción
# - Las variables NEXT_PUBLIC_ son visibles en el cliente
# - Las variables sin NEXT_PUBLIC_ solo están disponibles en el servidor
